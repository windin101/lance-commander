extends GdUnitTestSuite
## HD mech models: skinned, keep the original animations, chosen by MechView.

func test_hd_bushwacker_is_skinned_and_animated() -> void:
	if not ResourceLoader.exists("res://assets/mechs/bushwacker_hd.glb"):
		return  # generated by tools/art/hd_mech.py
	var root: Node = load("res://assets/mechs/bushwacker_hd.glb").instantiate()
	var skel := root.find_child("*", true, false)
	var skels := root.find_children("*", "Skeleton3D", true, false)
	assert_int(skels.size()).is_greater(0)
	var player: AnimationPlayer = root.find_child("AnimationPlayer", true, false)
	for a in ["Walk", "Run", "Idle", "FallForward"]:
		assert_bool(player.has_animation(a)).is_true()
	assert_object(MechPaint.load_mask("bushwacker_hd")).is_not_null()
	root.free()


func test_mech_view_prefers_hd_model() -> void:
	if not ResourceLoader.exists("res://assets/mechs/bushwacker_hd.glb"):
		return
	var sm := SimMission.load_mission(GameData, "mc2_01")
	var bw: SimUnit = sm.world.units[1]
	var v := MechView.new()
	add_child(v)
	v.setup(bw, sm.world.map)
	assert_str(v._paint_name).is_equal("bushwacker_hd")
	assert_int(v.model.find_children("*", "Skeleton3D", true, false).size()).is_greater(0)
	v.queue_free()
