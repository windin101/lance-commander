; Engine configuration file.

config_version=5

[application]

config/name="Lance Commander - Battle for the Sphere"
config/description="Free, non-commercial remake built on the 2006 MechCommander 2 Shared Source release."
run/main_scene="res://scenes/intro.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[autoload]

GameData="*res://scripts/data/game_data.gd"
DevTools="*res://scripts/dev/dev_tools.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/dpi/allow_hidpi=true

[editor_plugins]

enabled=PackedStringArray("res://addons/gdUnit4/plugin.cfg")
